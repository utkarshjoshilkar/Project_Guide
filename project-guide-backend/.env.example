# =============================================================================
# .env.example — Spring Boot environment variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Active Profile ───────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── MySQL Database ───────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/project_guide_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ── JWT Security ─────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_minimum_256_bits_long_change_this_in_production
JWT_EXPIRATION_MS=86400000

# ── AI Roadmap Microservice ──────────────────────────────────────────────────
# Local: http://localhost:8000
# Docker: http://ai-service:8000  (use the docker-compose service name)
AI_SERVICE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=60000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:5173
